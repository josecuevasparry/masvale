# Copy to api/.env and fill in. Never commit the real values.

# --- server -----------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Origins allowed to call the API from the browser (comma separated).
# The browser compares origins exactly, so list every host the site is served
# from — masvale.cl and www.masvale.cl are different origins.
#   CORS_ORIGINS=https://masvale.cl,https://www.masvale.cl
# `*` accepts any origin (handy to unblock a first request; less safe).
# A missing origin here shows up in the browser as
#   "No 'Access-Control-Allow-Origin' header is present on the requested resource"
# and the API logs "[cors] origen no permitido: ...".
CORS_ORIGINS=https://masvale.cl,https://www.masvale.cl
# Bearer token for /api/admin/* — make it long and random.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Where the JSON data files live (used only when MySQL is not configured).
DATA_DIR=./data
# Where uploaded article pictures are written and served from (/uploads).
UPLOADS_DIR=./uploads
# Max size of an uploaded picture, in bytes (default 8 MB).
UPLOADS_MAX_BYTES=8388608
PUBLIC_SITE_URL=https://masvale.cl

# --- database ---------------------------------------------------------------
# Local XAMPP defaults: root, no password, port 3306. Create the schema with
#   npm run db:setup
# When DB_NAME is set, the API stores in MySQL instead of the JSON files.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=masvale
DB_CONNECTION_LIMIT=5

# --- site / mail ------------------------------------------------------------
SITE_NAME=Masvale Consultores
ADMIN_EMAIL=josecuevasparry@masvale.cl
SMTP_HOST=mail.masvale.cl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=josecuevasparry@masvale.cl
SMTP_PASS=your-mailbox-password
SMTP_FROM=Masvale Consultores <josecuevasparry@masvale.cl>
SMTP_REPLY_TO=josecuevasparry@masvale.cl

# --- Google Calendar --------------------------------------------------------
# Either a service account with the calendar shared to it:
#   GOOGLE_SERVICE_ACCOUNT_FILE=./api/google-service-account.json
# or a long-lived OAuth refresh token:
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   GOOGLE_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=josecuevasparry@masvale.cl
CALENDAR_TIMEZONE=America/Santiago
# Set to true to book meetings without touching Google Calendar.
GOOGLE_CALENDAR_DISABLED=false

# --- meeting rules ----------------------------------------------------------
MEETING_DURATION_MINUTES=45
MEETING_MIN_LEAD_HOURS=4
MEETING_MAX_DAYS_AHEAD=60
MEETING_START_HOUR=9
MEETING_END_HOUR=18
MEETING_SLOT_MINUTES=45
MEETING_WEEKDAYS=1,2,3,4,5
MEETING_IN_PERSON_LOCATION=Oficina Masvale, Santiago
